VITE_SETTINGS_PASSWORD=Superdad
VITE_MATH_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vT39Z4a1Q..../pub?output=csv
VITE_ENGLISH_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vR..../pub?output=csv

# Kani cross-app integration. Local/dev remains disabled unless explicitly enabled.
# The GitHub Pages production workflow currently enables Learn only for reviewed subject `grade4math`.
# Practice remains disabled in production until the real Worksheet App source replaces the engineering fixture.
VITE_STUDY_HUB_BASE_URL=https://reallaksh19.github.io/Study-Hub
VITE_STUDY_HUB_CATALOG_PATH=/content/catalog.json
VITE_STUDY_HUB_ALLOWED_ORIGINS=https://reallaksh19.github.io
# Optional comma-separated Learn rollout allowlists. Leave empty to expose all published catalog content when Learn is enabled.
VITE_STUDY_HUB_ALLOWED_SUBJECTS=
VITE_STUDY_HUB_ALLOWED_GRADES=
VITE_KANI_LEARN_ENABLED=false
VITE_KANI_PRACTICE_ENABLED=false

# Authenticated learner sync. Keep disabled until a real Supabase project, guardian auth and staging smoke are configured.
# The API base should include the function and domain API prefix, e.g.
# https://<project>.supabase.co/functions/v1/kani-api/api/v1
VITE_KANI_SYNC_ENABLED=false
VITE_KANI_API_BASE_URL=
VITE_SUPABASE_URL=
# Public/publishable browser key only. Never place a secret/service-role key in VITE_* variables.
VITE_SUPABASE_PUBLISHABLE_KEY=
